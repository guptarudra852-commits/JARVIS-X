# OPENROUTER_API_KEY: Required to use OpenRouter as the primary neural AI agent of JARVIS X.
OPENROUTER_API_KEY=""

# OPENAI_API_KEY: Legacy fallback key for OpenRouter/OpenAI.
OPENAI_API_KEY=""

# DATABASE_URL: PostgreSQL connection URL to connect to Supabase database.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.ujkfareevrkzkbosaarm.supabase.co:5432/postgres
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
