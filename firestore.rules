rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    function isValidUser(data) {
      return (data.email is string && (data.email == "" || (data.email.size() <= 254 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')))) &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 30)) &&
             (data.role == null || (data.role is string && data.role.size() <= 50)) &&
             (data.approved == null || data.approved is bool) &&
             (data.createdAt == null || data.createdAt is timestamp) &&
             (data.lastLogin == null || data.lastLogin is timestamp);
    }
    
    function isValidChat(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.owner is string && data.owner.size() <= 128 && data.owner == request.auth.uid &&
             data.members is list && data.members.size() <= 100 &&
             data.messages is list && data.messages.size() <= 1000 &&
             data.createdAt is timestamp;
    }
    
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Chats collection
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.members);
      allow create: if isSignedIn() && isValidId(chatId) &&
                       isValidChat(request.resource.data) &&
                       request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isValidId(chatId) &&
                       (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.members) &&
                       request.resource.data.owner == resource.data.owner &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         // Action 1: Add member (owner only)
                         (request.resource.data.members.size() > resource.data.members.size() && 
                          resource.data.owner == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])) ||
                         
                         // Action 2: Send message
                         (request.resource.data.messages.size() > resource.data.messages.size() &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages']))
                       );
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && 
                       isValidUser(request.resource.data);
      allow update: if isSignedIn() && (
                       (request.auth.uid == userId &&
                        request.resource.data.email == resource.data.email &&
                        (resource.data.role == null || request.resource.data.role == resource.data.role) &&
                        (resource.data.approved == null || request.resource.data.approved == resource.data.approved)) ||
                       isAdmin()
                     );
    }
  }
}
